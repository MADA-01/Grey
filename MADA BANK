    static void deleteUser() {
        System.out.print("✍️ Enter username to DELETE: ");
        String delName = scanner.nextLine();

        // Protect main admin account
        if (delName.equalsIgnoreCase("Mark")) {
            System.out.println("❌ Cannot delete main admin account!");
            return;
        }

        // Find & remove user
        for (int i = 0; i < userList.size(); i++) {
            if (userList.get(i).username.equalsIgnoreCase(delName)) {
                userList.remove(i);
                System.out.println("✅ User deleted successfully!");
                return;
            }
        }
        System.out.println("❌ User not found!");
    }
}
